{
  "name": "useful-toolbox",
  "productName": "Useful Toolbox",
  "version": "1.6.2",
  "description": "Apps, games and tools in one window",
  "author": "Dovi",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy": "node -e \"const fs=require('fs');fs.rmSync('app',{recursive:true,force:true});fs.cpSync('../toolbox','app',{recursive:true})\"",
    "start": "npm run copy && electron .",
    "build": "npm run copy && electron-builder --win portable --x64",
    "lan": "node -e \"require('./lan-server').createLanServer(require('path').resolve('../toolbox')).start().then(i=>{console.log('ToolBox is hosting on your Wi-Fi. Open one of these in any browser:');i.ips.concat('localhost').forEach(ip=>console.log('  http://'+ip+':'+i.port+'/'))})\"",
    "build:linux": "npm run copy && electron-builder --linux AppImage --x64 --arm64"
  },
  "build": {
    "appId": "local.dovi.useful-toolbox",
    "productName": "Useful Toolbox",
    "electronVersion": "44.7.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lan-server.js",
      "package.json",
      "app/**/*"
    ],
    "win": {
      "icon": "icon.png",
      "target": "portable"
    },
    "portable": {
      "artifactName": "UsefulToolbox.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Utility",
      "synopsis": "Apps, games and tools in one window"
    },
    "appImage": {
      "artifactName": "TheToolBox-${arch}.AppImage"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
