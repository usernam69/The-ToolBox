{
  "name": "useful-toolbox",
  "productName": "Useful Toolbox",
  "version": "1.6.1",
  "description": "64 small everyday tools in one window",
  "author": "Dovi",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy": "node -e \"const fs=require('fs');fs.rmSync('app',{recursive:true,force:true});fs.cpSync('../toolbox','app',{recursive:true})\"",
    "start": "npm run copy && ..\\node_modules\\.bin\\electron .",
    "build": "npm run copy && ..\\node_modules\\.bin\\electron-builder --win portable --x64",
    "lan": "node -e \"require('./lan-server').createLanServer(require('path').resolve('../toolbox')).start().then(i=>{console.log('ToolBox is hosting on your Wi-Fi. Open one of these in any browser:');i.ips.concat('localhost').forEach(ip=>console.log('  http://'+ip+':'+i.port+'/'))})\""
  },
  "build": {
    "appId": "local.dovi.useful-toolbox",
    "productName": "Useful Toolbox",
    "electronVersion": "44.7.0",
    "electronDist": "../node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lan-server.js",
      "package.json",
      "app/**/*"
    ],
    "win": {
      "icon": "icon.png",
      "target": "portable"
    },
    "portable": {
      "artifactName": "UsefulToolbox.exe"
    }
  }
}
