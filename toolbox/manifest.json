{
  "name": "The ToolBox",
  "short_name": "ToolBox",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#f6f5f2",
  "theme_color": "#2f6fde",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "./",
  "scope": "./",
  "description": "The ToolBox: 100+ small tools, games and creative apps that work offline.",
  "shortcuts": [
    {
      "name": "Parkour",
      "url": "./apps/parkour.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Sticky notes",
      "url": "./apps/sticky.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Timers",
      "url": "./tools.html#timers",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "All tools",
      "url": "./tools.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./apps/open.html",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp",
          ".bmp"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "audio/*": [
          ".mp3",
          ".wav",
          ".ogg",
          ".m4a"
        ],
        "video/*": [
          ".mp4",
          ".webm",
          ".mov"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./apps/open.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "audio/*",
            "video/*",
            "application/pdf",
            "text/html",
            "application/json",
            ".json",
            ".html"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
